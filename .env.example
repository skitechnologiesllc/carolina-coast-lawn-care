# Resend API key — get yours at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email address that receives contact form submissions
CONTACT_EMAIL=ccmblawncare@gmail.com

# Verified sender address in Resend (use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Public site URL used for canonical tags, Open Graph, and sitemap.
# In production builds this falls back to https://carolinacoastlawncare.com if unset.
# Locally, omit this or set http://localhost:3003
NEXT_PUBLIC_SITE_URL=https://carolinacoastlawncare.com
