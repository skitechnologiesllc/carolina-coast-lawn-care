# Resend API key — get yours at https://resend.com/api-keys
# Never commit the real key. Set this in the hosting platform for production.
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email address that receives contact form submissions
CONTACT_EMAIL=ccmblawncare@gmail.com

# Sender address for estimate emails.
# Production: MUST be an address on a domain verified in Resend (https://resend.com/domains).
# Example after verifying carolinacoastlawncare.com:
# RESEND_FROM_EMAIL=Carolina Coast Lawn Care <estimates@carolinacoastlawncare.com>
#
# onboarding@resend.dev is for local testing only and can only send to your Resend
# account email — it will fail in production when delivering to CONTACT_EMAIL.
RESEND_FROM_EMAIL=Carolina Coast Lawn Care <estimates@your-verified-domain.com>

# Public site URL used for canonical tags, Open Graph, and sitemap.
# In production builds this falls back to https://carolinacoastlawncare.com if unset.
# Locally, omit this or set http://localhost:3003
NEXT_PUBLIC_SITE_URL=https://carolinacoastlawncare.com
